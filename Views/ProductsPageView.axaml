<UserControl
  x:Class="PrazoCerto.Views.ProductsPageView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="clr-namespace:PrazoCerto.Views"
  xmlns:vm="using:PrazoCerto.ViewModels"
  d:DesignHeight="450"
  d:DesignWidth="800"
  x:DataType="vm:ProductsPageViewModel"
  mc:Ignorable="d">
  
  <Design.DataContext>
    <vm:ProductsPageViewModel/>
  </Design.DataContext>
  
  
  
  <Grid Margin="15" RowDefinitions="Auto, *">

    <StackPanel
      Grid.Row="0"
      Orientation="Vertical"
      Spacing="10">
      <!--  Logo  -->
      
      <Image
        Width="250"
        Margin="0,0,0,10"
        HorizontalAlignment="Left"
        Source="avares://PrazoCerto/Assets/lista_de_produtos.png" />

    </StackPanel>

    <!--  Gray Border  -->
    <Border
      x:Name="MyBorder"
      Grid.Row="1"
      Padding="15"
      Background="DarkGray"
      CornerRadius="15,15,0,0">
      
      
      
      <StackPanel Orientation="Vertical" Spacing="15">
        
        <StackPanel Orientation="Horizontal">

          <!--  Search Selection ComboBox  -->
          <ComboBox
            Width="100"
            Margin="10,0,0,0"
            Background="#1a1a1a"
            Foreground="White"
            SelectedIndex="0"
            SelectedItem="{Binding ComboBoxSelectedItem}">

            <ComboBoxItem Content="Nome" Tag="Name" />
            <ComboBoxItem Content="Código" Tag="CodeBar" />
          </ComboBox>

          <TextBox
            Width="350"
            Margin="5,0,0,0"
            HorizontalAlignment="Left"
            Text="{Binding SearchTextBox, Mode=TwoWay}"
            Watermark="Pesquisar" />

          <!--  Search Button -->
          <Button
            Margin="5,0,0,0"
            Background="#1a1a1a"
            Command="{Binding SearchButtonCommand}"
            Content="pesquisar"
            Foreground="White" />

          <!-- Clear selected search and search bar -->
          <Button
            Margin="5,0,0,0"
            Background="#1a1a1a"
            Command="{Binding ClearSelectionCommand}"
            Content="Limpar"
            Foreground="White" />

          <!--  Edit Button -->
          <Button
            Width="30"
            Height="30"
            Margin="5,0,0,0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="#1a1a1a"
            Command="{Binding EditProductCommand}"
            ToolTip.Tip="Editar Item">
            <PathIcon Data="{StaticResource pencil_regular}" Foreground="White" />
          </Button>

          <!--  Agree delete popup  -->
          <Popup
            IsOpen="{Binding DeleteNotificationPopup}">
            <Border
              CornerRadius="5"
              BorderBrush="Black"
              BorderThickness="1"
              Height="75" Width="125" 
              Background="#a1a1a1" 
              Opacity="{Binding DeleteNotificationOpacity}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label 
                  Content="Deseja apagar?"
                  Foreground="Black"/>
                <StackPanel HorizontalAlignment="Center" Spacing="5" Orientation="Horizontal">
                  <Button 
                    Foreground="White"
                    Content="Sim"
                    Command="{Binding ConfirmDeleteCommand}"
                    Background="Black"/>
                  <Button 
                    Foreground="White"
                    Background="Black"
                    Content="Não"
                    Command="{Binding DenyDeleteCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Popup>
          
          <!-- Remove button-->
          <Button
            Width="30"
            Height="30"
            Margin="5,0,0,0"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="#1a1a1a"
            Command="{Binding DeleteButtonCommand}"
            ToolTip.Tip="Deletar">
            <PathIcon Data="{StaticResource trashcan_regular}" Foreground="White" />
          </Button>
          
          <!-- Add Product button-->
          <Button
            Width="30"
            Height="30"
            Margin="5,0,0,0"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="#1a1a1a"
            Command="{Binding AddButtonCommand}"
            ToolTip.Tip="Adicionar">
            <PathIcon
              Data="{StaticResource Add_regular}"
              Foreground="White"/>
          </Button>
        </StackPanel>


        <ScrollViewer VerticalScrollBarVisibility="Auto">
          
          <!-- Products Data grid -->
          <DataGrid
            x:Name="MyDataGrid"
            Height="{Binding DatagridHeight}"
            Margin="10,0,0,0"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            Foreground="Black"
            GridLinesVisibility="All"
            IsReadOnly="True"
            ItemsSource="{Binding ProductsList}"
            SelectedItem="{Binding DataGridSelectedProduct, Mode=TwoWay}">

            <DataGrid.Columns>
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding Name}"
                Header="Nome" />

              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding CodeBar}"
                Header="Código de Barras" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding ExpirationDate, StringFormat='{}{0:d}'}"
                Header="Validade" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding TimeRemaining}"
                Header="Tempo até Vencer" />
              <DataGridTextColumn
                Width="*"
                Binding="{Binding Amount}"
                Header="Quantidade" />
            </DataGrid.Columns>
          </DataGrid>
        </ScrollViewer>
        
        <!-- Saved notification popup -->
        <views:BottomNotificationPopupView HorizontalAlignment="Center"/>
        
        <!--  Edit product Popup  -->
        <Popup
          IsOpen="{Binding IsEditPopupOpen}"
          Placement="AnchorAndGravity"
          PlacementTarget="{Binding $parent[Window]}">
          
          <Border
            Padding="15"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="15">
            
            <StackPanel Orientation="Horizontal">
              <!-- Product Form Field -->
              <views:ProductFormField/>

              <Grid RowDefinitions="*,*">
                
                <!-- Save Button -->
              <Button Grid.Row="1"
                      Height="30"
                      Width="30"
                      Background="#1a1a1a"
                      VerticalAlignment="Bottom" 
                      Command="{Binding SaveProductCommand}">
                <PathIcon 
                  Data="{StaticResource save_as_regular}" 
                  Foreground="White"/>
              </Button>
                <!-- Close Button -->
                <Button
                  Height="30"
                  Width="30"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Foreground="White"
                  Background="#1a1a1a"
                  Grid.Row="0" 
                  Content="X" 
                  VerticalAlignment="Top" 
                  Command="{Binding ClosePopUpCommand}"/>
            </Grid>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
