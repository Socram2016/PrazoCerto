<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrazoCerto.ViewModels"
             x:DataType="vm:ConfigPageViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PrazoCerto.Views.ConfigPageView">
    <UserControl.Styles>
        <Styles>
            <Style Selector="Label">
                <Setter Property="Foreground" Value="Black"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
            </Style>
        </Styles>
    </UserControl.Styles>
    
    <Grid Margin="15" RowDefinitions="Auto,*">
        
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal">

            <Image
                Width="250"
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                Source="avares://PrazoCerto/Assets/produtos_vencidos.png" />
        </StackPanel>

        
        <Border
            x:Name="MyBorder"
            Grid.Row="1"
            Background="DarkGray"
            Padding="15"
            CornerRadius="15,15,0,0">
            
            <StackPanel Margin="15" Spacing="10">
                <Label
                    HorizontalContentAlignment="Left"
                    Content="Tempo antes do vencimento para notificar"></Label>
                <StackPanel  Spacing="10" Orientation="Horizontal">
                    
                    <!-- Days amount -->
                    <TextBox 
                        Text="{Binding ConfigToExpirationNotif}" 
                        CornerRadius="10"/>
                    <Label
                        VerticalContentAlignment="Center" 
                        Content="Dias"></Label>
                </StackPanel>
                <Button
                    Command="{Binding SaveConfigCommand}" 
                    Foreground="White" 
                    Content="Save"></Button>
            </StackPanel>
        </Border>
    </Grid>
    
</UserControl>
