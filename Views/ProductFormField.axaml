<UserControl
  x:Class="PrazoCerto.Views.ProductFormField"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:PrazoCerto.ViewModels"
  x:DataType="vm:ProductFormFieldViewModel"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  
  <UserControl.Styles>
    <Styles>
      <Style Selector="Label">
        <Setter Property="Foreground" Value="Black"/>
      </Style>
    </Styles>
  </UserControl.Styles>
  
  <Grid 
    ColumnSpacing="10" 
    RowSpacing="5" 
    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
    ColumnDefinitions="Auto,Auto,Auto,Auto">

    <Border
      Grid.Row="0"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Width="425"
      Padding="20"
      HorizontalAlignment="Left"
      BorderBrush="Black"
      BorderThickness="1"
      CornerRadius="8" />

    <!--  Name  -->
    <Label
      Grid.Row="0"
      Grid.Column="0"
      Margin="10,0,0,0"
      VerticalAlignment="Center"
      Content="Nome do Produto"
      FontSize="16"
      FontWeight="Bold"/>

    <TextBox
      Text="{Binding NewProductName}"
      BorderBrush="{Binding NewProductNameBrush}"
      Grid.Row="0"
      Grid.Column="1"
      Width="240"
      Height="35"
      HorizontalAlignment="Left"
      Background="White"
      CornerRadius="10"
      FontFamily="Arial"/>

    <Border
      Grid.Row="1"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Width="425"
      Padding="20"
      HorizontalAlignment="Left"
      BorderBrush="Black"
      BorderThickness="1"
      CornerRadius="8" />

    <!--  CodeBar  -->
    <Label
      Grid.Row="1"
      Grid.Column="0"
      Margin="10,0,0,0"
      VerticalAlignment="Center"
      Content="Código de Barras"
      FontSize="16"
      FontWeight="Bold" />
    <TextBox
      Text="{Binding NewProductCodeBar}"
      BorderBrush="{Binding NewProductCodeBarBrush}"
      Grid.Row="1"
      Grid.Column="1"
      Width="240"
      Height="35"
      HorizontalAlignment="Left"
      Background="White"
      CornerRadius="10" />

    <!-- Validity border -->
    <Border
      Grid.Row="2"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Width="425"
      Padding="20"
      HorizontalAlignment="Left"
      BorderBrush="Black"
      BorderThickness="1"
      CornerRadius="8" />

    <!--  Validity  -->
    <Label
      Grid.Row="2"
      Grid.Column="0"
      Margin="10,0,0,0"
      VerticalAlignment="Center"
      Content="Data de Validade"
      FontSize="16"
      FontWeight="Bold"/>
    <StackPanel
      Grid.Row="2"
      Grid.Column="1"
      Height="35"
      Orientation="Horizontal"
      Spacing="10">
      <!--  Day  -->
      <TextBox
        Text="{Binding NewProductDay}"
        BorderBrush="{Binding NewProductDayBrush}"
        CornerRadius="10"
        MaxLength="2"/>
      <!--  Month  -->
      <TextBox
        Text="{Binding NewProductMonth}"
        BorderBrush="{Binding NewProductMonthBrush}"
        CornerRadius="10"
        MaxLength="2" />
      <!--  Year  -->
      <TextBox
        Text="{Binding NewProductYear}"
        BorderBrush="{Binding NewProductYearBrush}"
        CornerRadius="10"
        MaxLength="4" />
    </StackPanel>

    <!-- Amount border -->
    <Border
      Grid.Row="3"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Width="250"
      Padding="20"
      HorizontalAlignment="Left"
      BorderBrush="Black"
      BorderThickness="1"
      CornerRadius="8" />

    <!--  Amount  -->
    <Label
      Grid.Row="3"
      Grid.Column="0"
      Margin="10,0,0,0"
      VerticalAlignment="Center"
      Content="Quantidade"
      FontSize="16"
      FontWeight="Bold" />
    <TextBox
      Text="{Binding NewProductAmount}"
      BorderBrush="{Binding NewProductAmountBrush}"
      Grid.Row="3"
      Grid.Column="1"
      Width="55"
      Height="35"
      HorizontalAlignment="Left"
      CornerRadius="10" />
  </Grid>
</UserControl>
