<UserControl
  x:Class="PrazoCerto.Views.AddProductPageView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="clr-namespace:PrazoCerto.Views"
  xmlns:vm="using:PrazoCerto.ViewModels"
  d:DesignHeight="450"
  d:DesignWidth="800"
  x:DataType="vm:AddProductPageViewModel"
  mc:Ignorable="d">

  <Design.DataContext>
    <vm:AddProductPageViewModel />
  </Design.DataContext>


  <Grid Margin="15" RowDefinitions="Auto, *">

    <StackPanel Grid.Row="0" Orientation="Horizontal">

      <Image
        Width="250"
        Margin="0,0,0,10"
        HorizontalAlignment="Left"
        Source="avares://PrazoCerto/Assets/adicionar_produto.png" />
    </StackPanel>

    <Border
      Grid.Row="1"
      Padding="15"
      Background="DarkGray"
      CornerRadius="15,15,0,0">


      <StackPanel>
        
        <!-- ImportProductFormField -->
        <views:ProductFormField/>

        <!--  Button Save  -->
        <Button
          Margin="0,15,0,0"
          HorizontalAlignment="Left"
          Background="#1a1a1a"
          Command="{Binding SaveButtonCommand}">
          <PathIcon Data="{StaticResource save_as_regular}" Foreground="White" />
        </Button>

      </StackPanel>

    </Border>
  </Grid>
</UserControl>
