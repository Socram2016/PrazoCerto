<UserControl
  x:Class="PrazoCerto.Views.AddProductPageView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="clr-namespace:PrazoCerto.Views"
  xmlns:vm="using:PrazoCerto.ViewModels"
  d:DesignHeight="450"
  d:DesignWidth="800"
  x:DataType="vm:AddProductPageViewModel"
  mc:Ignorable="d">

  <Design.DataContext>
    <vm:AddProductPageViewModel />
  </Design.DataContext>


  <Grid Margin="15" RowDefinitions="Auto, *">

    <StackPanel Grid.Row="0" Orientation="Horizontal">

      <Image
        Width="250"
        Margin="0,0,0,10"
        HorizontalAlignment="Left"
        Source="avares://PrazoCerto/Assets/adicionar_produto.png" />
    </StackPanel>

    <Border
      x:Name="MyBorder"
      Grid.Row="1"
      Padding="15"
      Background="DarkGray"
      CornerRadius="15,15,0,0">

      <Grid ColumnDefinitions="Auto,*">
        
        <StackPanel Grid.Column="0" Orientation="Vertical">
        
          <!-- ImportProductFormField -->
          <views:ProductFormField/>

          <!--  Button Save  -->
          <Button
            Margin="0,15,0,0"
            HorizontalAlignment="Left"
            Background="#1a1a1a"
            Command="{Binding SaveButtonCommand}">
            <PathIcon Data="{StaticResource save_as_regular}" Foreground="White" />
          </Button>

        </StackPanel>
        <!-- Notification -->
        <views:BottomNotificationPopupView Grid.Column="0" />

        <!--Sync List-->
        <Border 
          Grid.Column="1"
          CornerRadius="15"
          BorderThickness="1" 
          BorderBrush="Black" 
          HorizontalAlignment="Center" >
          
          <StackPanel 
            Margin="15" 
            Spacing="5"  
            Orientation="Vertical" 
            HorizontalAlignment="Center">
          
            <TextBlock 
              FontWeight="Bold" 
              Margin="0,0,0,10"
              Foreground="Black"
              Text="Sincronizar" />

            <ListBox  
              Background="DarkGray"
              ItemsSource="{Binding SyncItems}">
              
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Background" Value="White"></Setter>
                  <Setter Property="Margin" Value="5"></Setter>
                  <Setter Property="CornerRadius" Value="5"></Setter>
                  <Setter Property="Height" Value="35"></Setter>
                  <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                  <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                </Style>
                <Style Selector="ListBoxItem.On"></Style>
              </ListBox.Styles>
              
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SyncItemTemplate}">
                  <StackPanel 
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock 
                      Foreground="Black"
                      Text="{Binding Label}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
              
            </ListBox>
            
          </StackPanel> 
        </Border>
      </Grid>
    </Border>
  </Grid>
  
</UserControl>
